# flow/mk/sim_verilator.mk -- build, sim, waves (and cov) with Verilator.
# Active only when SIM=verilator (common.mk includes sim_$(SIM).mk). Block-independent.

ifeq ($(SIM),verilator)
ifndef _SIM_VERILATOR_MK
_SIM_VERILATOR_MK := 1

ifneq ($(call flow_on,$(UVM)),)
  $(error UVM=1 needs a commercial simulator: use SIM=vcs)
endif

VERILATOR        ?= verilator
VERILATOR_FLAGS  ?=
# C++ compiler for the generated model. --timing needs C++20 coroutines (g++ >= 10);
# env.sh sets VERILATOR_CXX/VERILATOR_LDFLAGS when the default g++ is older (RHEL 8).
VERILATOR_CXX     ?=
VERILATOR_LDFLAGS ?=
# Waivers: the block's lint/<ip>.vlt also applies to the simulation build (-Wall).
VLT_WAIVERS      ?= $(wildcard $(IP_DIR)/lint/$(IP).vlt)

# One model directory per build variant: WAVES and COV change the compiled model.
VLT_VARIANT   := $(if $(call flow_on,$(WAVES)),_trace)$(if $(call flow_on,$(COV)),_cov)
VLT_MODEL_DIR := $(SIM_DIR)/verilator$(VLT_VARIANT)
VLT_BIN       := $(VLT_MODEL_DIR)/V$(TB_TOP)
VLT_WAVE_SV   := $(VLT_MODEL_DIR)/flow_wave_dump.sv
VLT_VERSION    = $(shell $(VERILATOR) --version 2>/dev/null)
# Flat, de-duplicated file list (flist_expand.sh --flat), as for VCS: a file reached through
# two nested lists (R4 diamond: mem_if.sv via dcache.f and arb_mem.f) is compiled once;
# Verilator reading the nested lists itself would report MODDUP.
VLT_FLAT      := $(VLT_MODEL_DIR)/tb_flat.f

# WAVES=1: FST tracing. The dump is started by a generated module bound into TB_TOP, so
# no testbench has to contain $dumpfile/$dumpvars; the file name comes from +WAVE_FILE=.
VLT_WAVE_FLAGS := $(if $(call flow_on,$(WAVES)),--trace-fst --trace-structs $(VLT_WAVE_SV))
VLT_COV_FLAGS  := $(if $(call flow_on,$(COV)),--coverage)

# Lab V1: assertions are only compiled with --assert (Verilator 5.013 silently drops them
# otherwise); --coverage-user makes cover-property pass actions run; uninitialized state
# (missing resets) gets random values derived from SEED instead of 0 (two-state simulator).
VLT_CHECK_FLAGS ?= --assert --coverage-user --x-assign unique --x-initial unique
VLT_INIT_ARGS   ?= +verilator+rand+reset+2

VLT_BUILD_CMD := $(VERILATOR) --binary --timing -Wall --timescale 1ns/1ps \
                 --top-module $(TB_TOP) -Mdir $(VLT_MODEL_DIR) -o V$(TB_TOP) \
                 $(VLT_CHECK_FLAGS) \
                 $(PARAM_FLAGS) $(DEFINE_FLAGS) $(VLT_WAVE_FLAGS) $(VLT_COV_FLAGS) \
                 $(if $(VERILATOR_CXX),-MAKEFLAGS 'CXX=$(VERILATOR_CXX) LINK=$(VERILATOR_CXX)') \
                 $(if $(VERILATOR_LDFLAGS),-LDFLAGS '$(VERILATOR_LDFLAGS)') \
                 $(VERILATOR_FLAGS) $(VLT_WAIVERS) -f $(VLT_FLAT)

VLT_WAVE_FILE := $(SIM_DIR)/$(TEST_ID).fst
VLT_RUN_CMD   := $(VLT_BIN) +verilator+seed+$(SEED) $(VLT_INIT_ARGS) +TEST=$(TEST) +SEED=$(SEED) \
                 $(if $(call flow_on,$(WAVES)),+WAVE_FILE=$(VLT_WAVE_FILE)) \
                 $(if $(call flow_on,$(COV)),+verilator+coverage+file+$(COV_DIR)/$(TEST_ID).dat) \
                 $(PLUSARGS)

.PHONY: build sim waves cov

# The command line is a prerequisite: a change of flags rebuilds the model.
$(VLT_MODEL_DIR)/build.cmd: FORCE
	@mkdir -p $(@D)
	@echo '$(subst ','\'',$(strip $(VLT_BUILD_CMD)))' | cmp -s - $@ || \
	 echo '$(subst ','\'',$(strip $(VLT_BUILD_CMD)))' > $@

$(VLT_WAVE_SV):
	@mkdir -p $(@D)
	@printf '%s\n' \
	  '// generated by flow/mk/sim_verilator.mk -- starts the FST dump of $(TB_TOP)' \
	  'module flow_wave_dump;' \
	  '  initial begin' \
	  '    string f;' \
	  '    if ($$value$$plusargs("WAVE_FILE=%s", f)) begin' \
	  '      $$dumpfile(f);' \
	  '      $$dumpvars(0, $(TB_TOP));' \
	  '    end' \
	  '  end' \
	  'endmodule' \
	  'bind $(TB_TOP) flow_wave_dump u_flow_wave_dump ();' > $@

$(VLT_BIN): $(VLT_MODEL_DIR)/build.cmd $(call flist_deps,$(TB_FLIST_ABS)) $(VLT_WAIVERS) \
            $(if $(call flow_on,$(WAVES)),$(VLT_WAVE_SV))
	@$(call flist_flat,$(TB_FLIST_ABS),$(VLT_FLAT))
	@echo "build: $(IP) cfg=$(CFG) $(VLT_VERSION) -> $(VLT_MODEL_DIR)"
	@echo "$(strip $(VLT_BUILD_CMD))"
	@$(strip $(VLT_BUILD_CMD)) > $(VLT_MODEL_DIR)/build.log 2>&1 \
	  || { grep -v '^g++\|^ar \|^echo' $(VLT_MODEL_DIR)/build.log | tail -30; echo "build: FAIL log: $(VLT_MODEL_DIR)/build.log"; exit 1; }

build: $(VLT_BIN)

sim: $(VLT_BIN)
	@$(if $(call flow_on,$(COV)),mkdir -p $(COV_DIR))
	$(call flow_run_sim,$(VLT_RUN_CMD),$(VLT_VERSION))
	@$(if $(call flow_on,$(WAVES)),ln -sf $(notdir $(VLT_WAVE_FILE)) $(SIM_DIR)/last.fst && echo "waves: $(VLT_WAVE_FILE)")

WAVE_VIEWER ?= gtkwave
waves:
	@test -e $(SIM_DIR)/last.fst || { echo "waves: no $(SIM_DIR)/last.fst -- run 'make sim WAVES=1' first (same PARAMS/DEFINES)"; exit 1; }
	$(WAVE_VIEWER) $(SIM_DIR)/last.fst >/dev/null 2>&1 &

# COV=1 runs write $(COV_DIR)/<test>_s<seed>.dat; 'cov' merges and annotates them.
cov:
	@ls $(COV_DIR)/*.dat >/dev/null 2>&1 || { echo "cov: no coverage data -- run 'make sim COV=1' first"; exit 1; }
	verilator_coverage --write $(COV_DIR)/merged.dat $(COV_DIR)/*_s*.dat
	verilator_coverage --annotate $(COV_DIR)/annotated $(COV_DIR)/merged.dat | tee $(COV_DIR)/summary.txt

HELP_TARGETS += build sim waves cov
HELP_build := compile the simulation model of TB_TOP with Verilator ($(VLT_MODEL_DIR))
HELP_sim   := build if needed, run TEST with SEED; fail unless the log has TEST PASSED
HELP_waves := open the FST of the last 'sim WAVES=1' run in $(WAVE_VIEWER)
HELP_cov   := merge/annotate Verilator coverage of 'sim COV=1' runs ($(COV_DIR))
HELP_VARS  += SIM_LOG VERILATOR_FLAGS VERILATOR_CXX VERILATOR_LDFLAGS VLT_WAIVERS VLT_CHECK_FLAGS VLT_INIT_ARGS

endif # _SIM_VERILATOR_MK
endif # SIM=verilator
