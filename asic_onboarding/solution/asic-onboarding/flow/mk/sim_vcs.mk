# flow/mk/sim_vcs.mk -- build, sim, waves, cov with Synopsys VCS (+ Verdi, URG).
# Active only when SIM=vcs (common.mk includes sim_$(SIM).mk). Same targets and variables
# as sim_verilator.mk, plus UVM=1 (T-DV2) and COV=1 code coverage (V3). Block-independent.

ifeq ($(SIM),vcs)
ifndef _SIM_VCS_MK
_SIM_VCS_MK := 1

VCS        ?= vcs
VERDI      ?= verdi
URG        ?= urg
VCS_FLAGS  ?=
SIMV_FLAGS ?=

# One model directory per build variant: WAVES (debug access), COV and UVM change the model.
VCS_VARIANT   := $(if $(call flow_on,$(WAVES)),_dbg)$(if $(call flow_on,$(COV)),_cov)$(if $(call flow_on,$(UVM)),_uvm)
VCS_MODEL_DIR := $(SIM_DIR)/vcs$(VCS_VARIANT)
VCS_BIN       := $(VCS_MODEL_DIR)/simv
VCS_FLAT      := $(VCS_MODEL_DIR)/tb_flat.f
VCS_UCLI_DO   := $(VCS_MODEL_DIR)/fsdb_dump.tcl
# Version from the install path (<root>/<version>/bin/vcs); 'vcs -ID' prints only the year.
VCS_VERSION    = VCS $(notdir $(patsubst %/bin/vcs,%,$(shell command -v $(VCS))))
COV_VDB       := $(COV_DIR)/simv.vdb
COV_METRICS   ?= line+cond+fsm+tgl+branch+assert

# PARAMS -> top-level parameter overrides of TB_TOP.
VCS_PARAM_FLAGS := $(addprefix -pvalue+$(TB_TOP).,$(PARAMS))

VCS_BUILD_CMD := $(VCS) -full64 -sverilog -timescale=1ns/1ps -top $(TB_TOP) \
                 -f $(VCS_FLAT) $(VCS_PARAM_FLAGS) $(DEFINE_FLAGS) \
                 $(if $(call flow_on,$(UVM)),-ntb_opts uvm-1.2) \
                 $(if $(call flow_on,$(WAVES)),-kdb -debug_access+all) \
                 $(if $(call flow_on,$(COV)),-cm $(COV_METRICS) -cm_dir $(COV_VDB)) \
                 -Mdir=$(VCS_MODEL_DIR)/csrc -o $(VCS_BIN) $(VCS_FLAGS)

# WAVES=1: FSDB through a UCLI do-file generated here -- no testbench edits needed.
VCS_FSDB_FILE := $(SIM_DIR)/$(TEST_ID).fsdb
VCS_RUN_CMD   := $(VCS_BIN) -no_save +ntb_random_seed=$(SEED) +TEST=$(TEST) +SEED=$(SEED) \
                 $(if $(call flow_on,$(UVM)),+UVM_TESTNAME=$(TEST)) \
                 $(if $(call flow_on,$(WAVES)),-ucli -do $(VCS_UCLI_DO) +fsdbfile+$(VCS_FSDB_FILE)) \
                 $(if $(call flow_on,$(COV)),-cm $(COV_METRICS) -cm_dir $(COV_VDB) -cm_name $(TEST_ID)) \
                 $(SIMV_FLAGS) $(PLUSARGS)

.PHONY: build sim waves cov

$(VCS_MODEL_DIR)/build.cmd: FORCE
	@mkdir -p $(@D)
	@echo '$(subst ','\'',$(strip $(VCS_BUILD_CMD)))' | cmp -s - $@ || \
	 echo '$(subst ','\'',$(strip $(VCS_BUILD_CMD)))' > $@

$(VCS_UCLI_DO):
	@mkdir -p $(@D)
	@printf '%s\n' \
	  '# generated by flow/mk/sim_vcs.mk -- FSDB dump of $(TB_TOP)' \
	  'fsdbDumpvars 0 $(TB_TOP) +all' \
	  'run' \
	  'quit' > $@

$(VCS_BIN): $(VCS_MODEL_DIR)/build.cmd $(call flist_deps,$(TB_FLIST_ABS)) \
            $(if $(call flow_on,$(WAVES)),$(VCS_UCLI_DO))
	@$(call flist_flat,$(TB_FLIST_ABS),$(VCS_FLAT))
	@echo "build: $(IP) cfg=$(CFG) $(VCS_VERSION) -> $(VCS_MODEL_DIR)"
	@echo "$(strip $(VCS_BUILD_CMD))"
	@cd $(VCS_MODEL_DIR) && $(strip $(VCS_BUILD_CMD)) -l build.log > /dev/null \
	  || { tail -30 $(VCS_MODEL_DIR)/build.log; echo "build: FAIL log: $(VCS_MODEL_DIR)/build.log"; exit 1; }

build: $(VCS_BIN)

sim: $(VCS_BIN)
	@$(if $(call flow_on,$(COV)),mkdir -p $(COV_DIR))
	$(call flow_run_sim,$(VCS_RUN_CMD),$(VCS_VERSION))
	@$(if $(call flow_on,$(WAVES)),ln -sf $(notdir $(VCS_FSDB_FILE)) $(SIM_DIR)/last.fsdb && ln -sfn $(VCS_MODEL_DIR)/simv.daidir $(SIM_DIR)/last.daidir && echo "waves: $(VCS_FSDB_FILE)")

waves:
	@test -e $(SIM_DIR)/last.fsdb || { echo "waves: no $(SIM_DIR)/last.fsdb -- run 'make sim WAVES=1' first (same PARAMS/DEFINES)"; exit 1; }
	cd $(SIM_DIR) && $(VERDI) -dbdir $(SIM_DIR)/last.daidir -ssf $(SIM_DIR)/last.fsdb >/dev/null 2>&1 &

cov:
	@test -d $(COV_VDB) || { echo "cov: no $(COV_VDB) -- run 'make sim COV=1' first"; exit 1; }
	cd $(COV_DIR) && $(URG) -full64 -dir $(COV_VDB) -report $(COV_DIR)/urg_report -format both -log $(COV_DIR)/urg.log
	@echo "cov: report $(COV_DIR)/urg_report/dashboard.html (text: $(COV_DIR)/urg_report/dashboard.txt)"
	@test -f $(COV_DIR)/urg_report/dashboard.txt && sed -n '1,40p' $(COV_DIR)/urg_report/dashboard.txt || true

HELP_TARGETS += build sim waves cov
HELP_build := compile simv of TB_TOP with VCS ($(VCS_MODEL_DIR))
HELP_sim   := build if needed, run TEST with SEED; fail unless the log has TEST PASSED
HELP_waves := open the FSDB of the last 'sim WAVES=1' run in Verdi
HELP_cov   := URG report of the 'sim COV=1' runs ($(COV_VDB))
HELP_VARS  += SIM_LOG VCS_FLAGS SIMV_FLAGS COV_METRICS

endif # _SIM_VCS_MK
endif # SIM=vcs
